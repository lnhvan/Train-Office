# =============================================================
#  Train-Office — ENVIRONMENT VARIABLES TEMPLATE
#  Sao chép file này thành .env và điền giá trị thật vào.
#  File này an toàn để commit lên Git.
# =============================================================

# --- JWT ---
JWT_SECRET=

# --- Mail (Gmail App Password) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# --- VNPay ---
VNPAY_TMN_CODE=
VNPAY_SECRET_KEY=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:8081/payments/vnpay-return

# --- Google OAuth 2.0 ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8081/google-login
